<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>PortViewer</AssemblyName>
    <RootNamespace>PortViewer</RootNamespace>
    <ApplicationIcon>Assets\PortViewer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PortViewer.Core\PortViewer.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\PortViewer.ico" />
  </ItemGroup>
</Project>
