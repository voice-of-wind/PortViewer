<Window x:Class="PortViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PortViewer · 端口与文件占用排查" Width="1260" Height="780"
        Icon="Assets/PortViewer.ico"
        MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}" FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource InkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#13213A" Padding="26,21">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="P O R T V I E W E R" Foreground="#78A6FF" FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock Text="端口与文件占用排查" Foreground="White" FontSize="25"
                               FontWeight="SemiBold" Margin="0,5,0,0" />
                    <TextBlock Text="定位占用者、核对影响范围，再决定是否结束进程"
                               Foreground="#B6C3D9" FontSize="13" Margin="0,7,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#203454" CornerRadius="10" Padding="15,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#47D7A1" Margin="0,0,9,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="正在准备首次扫描" Foreground="#E7EEFA"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,15,20,0">
            <Button x:Name="PortPageButton" Content="端口占用" Click="PortPageButton_OnClick"
                    Background="{StaticResource AccentBrush}" Foreground="White" Margin="0,0,9,0" />
            <Button x:Name="FilePageButton" Content="文件占用" Click="FilePageButton_OnClick" />
        </StackPanel>

        <Grid x:Name="PortPage" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        <Border Grid.Row="0" Margin="20,12,20,12" Background="White" CornerRadius="11"
                BorderBrush="#E1E7F0" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,14,0">
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_OnTextChanged"
                             ToolTip="可搜索端口、PID、进程、服务、协议、地址和状态" />
                    <TextBlock x:Name="SearchHint" Text="搜索端口、PID、进程或服务…"
                               Foreground="#98A3B6" IsHitTestVisible="False" Margin="13,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>
                <ComboBox x:Name="ScopeComboBox" Grid.Column="1" Width="164" Margin="0,0,14,0"
                          SelectionChanged="ScopeComboBox_OnSelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="监听端口" Tag="Listening" />
                    <ComboBoxItem Content="全部 TCP 连接" Tag="All" />
                </ComboBox>
                <CheckBox x:Name="AutoRefreshCheckBox" Grid.Column="2" Content="每 3 秒自动刷新"
                          IsChecked="True" Margin="0,0,18,0"
                          Checked="AutoRefreshCheckBox_OnChanged" Unchecked="AutoRefreshCheckBox_OnChanged" />
                <Button Grid.Column="3" Content="立即刷新" Margin="0,0,10,0" Click="RefreshButton_OnClick" />
                <Button x:Name="KillButton" Grid.Column="4" Content="关闭占用进程"
                        Background="{StaticResource DangerBrush}" Foreground="White"
                        IsEnabled="False" Click="KillButton_OnClick" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="20,0,20,12" Background="White" CornerRadius="11"
                BorderBrush="#E1E7F0" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="EndpointGrid" ItemsSource="{Binding}" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EDF1F6" BorderThickness="0"
                      RowHeight="39" ColumnHeaderHeight="42" AlternatingRowBackground="#F9FBFE"
                      SelectionChanged="EndpointGrid_OnSelectionChanged"
                      MouseDoubleClick="EndpointGrid_OnMouseDoubleClick">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F2F5FA" />
                        <Setter Property="Foreground" Value="#526078" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="BorderBrush" Value="#E1E7F0" />
                        <Setter Property="Padding" Value="11,0" />
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding ExecutablePath}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="协议" Binding="{Binding ProtocolText}" Width="68" />
                    <DataGridTextColumn Header="类型" Binding="{Binding AddressFamily}" Width="66" />
                    <DataGridTextColumn Header="本地端点" Binding="{Binding LocalEndpoint}" Width="180" />
                    <DataGridTextColumn Header="远程端点" Binding="{Binding RemoteEndpoint}" Width="180" />
                    <DataGridTextColumn Header="状态" Binding="{Binding DisplayState}" Width="105" />
                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="78" />
                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessName}" Width="150" />
                    <DataGridTextColumn Header="Windows 服务" Binding="{Binding ServiceNames}" Width="*" MinWidth="180" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        </Grid>

        <Grid x:Name="FilePage" Grid.Row="2" Visibility="Collapsed" Margin="20,12,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" CornerRadius="11" BorderBrush="#E1E7F0"
                    BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="选择文件或文件夹" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="先尝试正常关闭相关程序；强制结束会丢失该进程未保存的工作。"
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,13" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FilePathBox" ToolTip="粘贴本机文件或文件夹完整路径"
                                 TextChanged="FilePathBox_OnTextChanged" />
                        <Button x:Name="PickFileButton" Grid.Column="1" Content="选文件" Margin="10,0,0,0" Click="PickFileButton_OnClick" />
                        <Button x:Name="PickFolderButton" Grid.Column="2" Content="选文件夹" Margin="10,0,0,0" Click="PickFolderButton_OnClick" />
                        <Button x:Name="ScanFileButton" Grid.Column="3" Content="查找占用进程" Margin="10,0,0,0"
                                Background="{StaticResource AccentBrush}" Foreground="White" Click="ScanFileButton_OnClick" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock x:Name="FileScanStatusText" Grid.Row="1" Text="尚未扫描。扫描结果是排查线索，打开句柄不一定阻止文件操作。"
                       Foreground="{StaticResource MutedBrush}" Margin="4,12" TextWrapping="Wrap" />
            <Border Grid.Row="2" Background="White" CornerRadius="11" BorderBrush="#E1E7F0"
                    BorderThickness="1" ClipToBounds="True">
                <DataGrid x:Name="FileProcessGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
                          SelectionUnit="FullRow" RowHeight="46" ColumnHeaderHeight="42"
                          SelectionChanged="FileProcessGrid_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="进程" Binding="{Binding Name}" Width="170" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="85" />
                        <DataGridTextColumn Header="关联服务" Binding="{Binding Services}" Width="190" />
                        <DataGridTextColumn Header="命中路径" Binding="{Binding MatchedPathsText}" Width="*" MinWidth="280" />
                        <DataGridTextColumn Header="端口记录" Binding="{Binding PortCount}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="请回到对应程序保存工作并正常关闭；必要时再强制结束。"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                <Button x:Name="FileDetailsButton" Grid.Column="1" Content="查看进程详情" IsEnabled="False"
                        Click="FileDetailsButton_OnClick" Margin="0,0,10,0" />
                <Button Grid.Column="2" Content="管理员模式重新扫描" Click="AdminScanButton_OnClick" Margin="0,0,10,0" />
                <Button x:Name="FileKillButton" Grid.Column="3" Content="强制结束所选进程" IsEnabled="False"
                        Background="{StaticResource DangerBrush}" Foreground="White" Click="FileKillButton_OnClick" />
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="#E1E7F0" BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatusText" Text="尚未扫描" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Grid.Column="1" Foreground="{StaticResource MutedBrush}">
                    <Run Text="提示：关闭端口会结束整个进程，该进程的其他端口也会释放" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
